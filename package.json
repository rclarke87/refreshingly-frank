{
  "name": "frank-site",
  "version": "1.0.0",
  "private": true,
  "description": "Frank's portfolio site. Frank by name, frank by nature.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "eleventy",
    "clean": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\"",
    "audit": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-rss": "3.1.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0",
    "chokidar": "4.0.3"
  }
}
